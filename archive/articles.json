   "title": "Regjeringen utreder midlertidig forbud mot nye kryptodatasentre (skriftlig spørsmål 15:3707)",
   "source": "stortinget",
   "source_name": "Stortinget",
   "published_at": "2026-09-18T12:00:00+00:00",
